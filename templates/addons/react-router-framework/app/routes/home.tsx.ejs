<% if (queries.shadcn) { %>
import { Button } from "@/components/ui/button";
<% } %>
<% if (queries.formsRHFZod || queries.formsTanstack || queries.authClerk || queries.authSupabase) { %>
import { Link } from "react-router";
<% } %>
<% if (queries.i18n) { %>
import { useTranslation } from "react-i18next";
import { LanguageSwitcher } from "../../src/components/LanguageSwitcher";
<% } %>

import type { Route } from "./+types/home";

export function meta({}: Route.MetaArgs) {
  return [
    { title: "New React Router App" },
    { name: "description", content: "Welcome to React Router!" },
  ];
}

export default function Home() {
  <% if (queries.i18n) { %>
  const { t } = useTranslation();
  <% } %>
  return (
    <div className="<%- queries.tailwind ? 'flex flex-col items-center justify-center gap-4 py-8' : '' %>">
      <% if (queries.i18n) { %>
      <LanguageSwitcher />
      <% } %>
      <h1 className="<%- queries.tailwind ? 'text-4xl font-bold tracking-tight' : '' %>">
        <% if (queries.i18n) { %>{t("home.welcome")}<% } else { %>Hello World<% } %>
      </h1>
      <p className="<%- queries.tailwind ? 'text-muted-foreground' : '' %>">
        <% if (queries.i18n) { %>{t("home.frameworkTagline")}<% } else { %>Official React Router V7 Framework<% } %>
      </p>

      <% if (queries.shadcn) { %>
      <div className="flex gap-2">
        <Button>Default</Button>
        <Button variant="secondary">Secondary</Button>
        <Button variant="outline">Outline</Button>
        <Button variant="ghost">Ghost</Button>
        <Button variant="destructive">Destructive</Button>
      </div>
      <% } %>

      <% if (queries.formsRHFZod || queries.formsTanstack) { %>
      <Link className="text-blue-600 hover:underline" to="/forms-demo">
        Go to Forms Demo
      </Link>
      <% } %>

      <% if (queries.authClerk || queries.authSupabase) { %>
      <div className="<%- queries.tailwind ? 'mt-6 flex gap-4' : '' %>">
        <Link className="text-blue-600 hover:underline" to="/login">
          Sign In
        </Link>
        <Link className="text-blue-600 hover:underline" to="/protected">
          Protected Area
        </Link>
      </div>
      <% } %>
    </div>
  );
}